{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"files": {
		"includes": ["src/**", "tests/**", "scripts/**"]
	},
	"assist": {
		"enabled": false
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "space",
		"lineWidth": 100,
		"lineEnding": "auto"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noAutofocus": "off",
				"noStaticElementInteractions": "off",
				"useAriaPropsSupportedByRole": "off",
				"useSemanticElements": "off"
			},
			"correctness": {
				"noUnsafeOptionalChaining": "off",
				"useExhaustiveDependencies": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noArrayIndexKey": "off",
				"noAssignInExpressions": "off"
			}
		}
	}
}
